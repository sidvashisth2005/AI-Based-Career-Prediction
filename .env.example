# Copy to .env and fill in. Everything is optional; the app runs fully offline without it.

# Enables the AI interviewer (personalised questions + rubric grading by Claude).
ANTHROPIC_API_KEY=

# auto = use Claude when a key is set, on = always try Claude, off = offline engine only
LLM_MODE=auto
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high: higher gives deeper questions/feedback but is slower and costs more
CLAUDE_EFFORT=medium

MAX_UPLOAD_MB=5
SESSION_TTL_MINUTES=120
