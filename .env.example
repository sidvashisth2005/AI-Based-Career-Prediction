# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your key.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# The app works fully offline without any key; a key turns on the AI interviewer
# (personalised questions + answer grading) and AI resume tailoring.
# Never commit your real .env file (it is already in .gitignore).
# ---------------------------------------------------------------------------

# ===== Google Gemini (recommended) =====
# Get a key at https://aistudio.google.com/apikey and paste it below,
# replacing the placeholder text.
GEMINI_API_KEY=paste-your-gemini-api-key-here
# Model to use. "gemini-flash-latest" always points to Google's newest Flash model.
# You can pin a specific model instead, e.g. GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# ===== Anthropic Claude (optional alternative) =====
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium

# ===== Which AI to use =====
# auto   = Gemini if GEMINI_API_KEY is set, otherwise Claude if ANTHROPIC_API_KEY is set, otherwise offline
# gemini = Gemini only      claude = Claude only      off = offline engine only
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=120

# ===== App limits =====
MAX_UPLOAD_MB=5
SESSION_TTL_MINUTES=120
